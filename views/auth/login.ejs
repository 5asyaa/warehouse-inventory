<div class="card shadow" style="width:420px">
    <div class="card-body">
        <div class="text-center mb-4">
            <i class="bi bi-box-seam fs-1 text-primary"></i>
            <h3 class="mt-2">Login</h3>
            <p class="text-muted">Masuk ke Warehouse</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
        <% } %>

        <form action="/auth/login" method="POST">
            <div class="mb-3">
                <label for="username">Username</label>
                <input id="username" data-testid="username-input" class="form-control" type="text" name="username" required>
            </div>

            <section class="mb-3">
                <label for="password">Password</label>
                <input id="password" data-testid="password-input" class="form-control" type="password" name="password" required>
            </section>

            <button id="login-button" data-testid="login-button" class="btn btn-primary w-100 d-flex align-items-center justify-content-center" style="height: 48px; font-weight: 600;">Login</button>
        </form>
    </div>
</div>

<script>
<% if (typeof error !== 'undefined' && error) { %>
    Swal.fire({
        icon: 'error',
        title: 'Login Gagal',
        text: '<%= error %>'
    });
<% } %>
</script>